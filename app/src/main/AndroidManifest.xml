<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse (not dataSync) for PrayerNotificationService: dataSync FGS cannot be
         launched from BOOT_COMPLETED on Android 15 and is killed after a ~6h budget. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Prayer notification permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ALARM" />
    
    <!-- Compass functionality - from original Compass-main app -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    
    <!-- Android Auto permissions -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <!--
    Firebase automatically adds these AD_ID and ADSERVICES permissions, even though we don'''t use them.
    If you use these permissions you must declare how you'''re using them to Google Play, otherwise the
    app will be rejected when publishing it. To avoid this we remove the permissions entirely.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>

    <application
        android:name=".SubmissionApplication"
        android:allowBackup="true"
        tools:replace="android:allowBackup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nia.Splash">
        <profileable android:shell="true" tools:targetApi="q" />

        <!-- Video Splash Screen Activity -->
        <activity
            android:name=".VideoSplashActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:theme="@style/Theme.Nia.VideoSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@style/Theme.Nia">
            <!-- Deep link for app content -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="starception.com" />
            </intent-filter>

            <!-- Deep link for course sharing -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="starception" />
                <data android:host="course" />
            </intent-filter>

            <!-- Configuration destination for the app-owned Prayer Time mode used
                 by Android 15+ to activate Do Not Disturb during prayer. -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- location for prayer-time positioning + specialUse for the persistent
             live prayer countdown. Both types are allowed to start from
             BOOT_COMPLETED on Android 15 and have no runtime budget, unlike the
             previous dataSync type (banned from boot, killed after ~6h). -->
        <service
            android:name=".services.PrayerNotificationService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent live prayer-time countdown notification and prayer activity detection" />
        </service>

        <!-- Explicit PendingIntent target for Google Activity Transition events.
             Manifest registration keeps driving detection reachable with no UI process. -->
        <receiver
            android:name=".services.DrivingActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false" />
            
        <!-- Drives the prayer widget's own refresh cadence.

             A widget's updatePeriodMillis is floored at 30 minutes by the framework,
             which is far too coarse for a card showing "16 minutes since Dhuhr" — it
             was seen 6 minutes out. This receiver takes a self-re-arming alarm, and
             also refreshes on unlock, since Doze is entitled to hold the alarm while
             the screen is off and the card would otherwise be stale exactly when the
             user first looks at it.

             Not exported: the alarm PendingIntent and the USER_PRESENT broadcast are
             both delivered by the system, neither needs another app to reach it. -->
        <receiver
            android:name=".widget.PrayerWidgetRefreshReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Home-screen prayer times widgets (Glance).

             Five receivers, one per size, because the launcher binds widgets by provider
             component: a single receiver can only ever produce a single picker entry.
             They all render the same responsive layouts and all stay resizable — the
             only difference is the footprint each one lands at when dropped.

             Exported because the launcher process is what delivers APPWIDGET_UPDATE. The
             clock actions are on each filter rather than in a separate receiver so a
             timezone or manual clock change redraws the wall-clock prayer times
             immediately instead of waiting out the 30-minute updatePeriodMillis. -->
        <receiver
            android:name=".widget.PrayerTimesTinyWidgetReceiver"
            android:exported="true"
            android:label="@string/prayer_widget_label_tiny">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_tiny_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesSmallWidgetReceiver"
            android:exported="true"
            android:label="@string/prayer_widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesWidgetReceiver"
            android:exported="true"
            android:label="@string/prayer_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesLargeWidgetReceiver"
            android:exported="true"
            android:label="@string/prayer_widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_large_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesFullWidgetReceiver"
            android:exported="true"
            android:label="@string/prayer_widget_label_full">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_full_info" />
        </receiver>


        <!-- Canonical widget layouts ported from platform-samples. Each is its own
             provider so the picker lists them separately, exactly as upstream does.
             LOCALE_CHANGED is on every filter because these layouts render localised
             strings that a language change would otherwise leave stale. -->
        <receiver
            android:name=".widget.samples.toolbars.ExpressiveToolbarAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_expressive_toolbar_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_expressive_toolbar_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.toolbars.ToolBarAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_toolbar_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_toolbar_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.toolbars.SearchToolBarAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_search_toolbar_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_search_toolbar_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.text.LongTextAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_long_text_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_long_text_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.text.TextWithImageAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_text_and_image_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_text_with_image_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.collections.ImageTextListAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_text_and_image_list_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_image_text_list_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.collections.CheckListAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_check_list_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_check_list_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.collections.ActionListAppWidgetAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_action_list_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_action_list_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.samples.collections.ImageGridAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/sample_image_grid_app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_image_grid_widget_info" />
        </receiver>

        <!-- Debug receiver to simulate driving detection via adb -->
        <receiver
            android:name=".util.DebugDrivingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.starception.submission.DEBUG_SIMULATE_DRIVING" />
            </intent-filter>
        </receiver>

        <!-- Debug receiver to simulate a prayer alert in PullToSyncContainer via adb -->
        <receiver
            android:name=".util.DebugPrayerAlertReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.starception.submission.DEBUG_SIMULATE_PRAYER_ALERT" />
            </intent-filter>
        </receiver>

        <!-- Debug receiver to force-show an Islamic-event banner via adb -->
        <receiver
            android:name=".util.DebugIslamicEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.starception.submission.DEBUG_SIMULATE_ISLAMIC_EVENT" />
            </intent-filter>
        </receiver>

        <!-- Prayer Action Receiver for notification actions like "Mark as Prayed" -->
        <receiver
            android:name=".util.PrayerActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.starception.submission.MARK_AS_PRAYED" />
            </intent-filter>
        </receiver>

        <!-- Exact wake-up alarm for Travel Dua playback while the app is sleeping. -->
        <receiver
            android:name=".util.TravelDuaAlarmReceiver"
            android:exported="false" />
        
        <!-- Prayer Notification Receiver for AlarmManager-triggered notifications -->
        <receiver
            android:name=".prayer.receiver.PrayerNotificationReceiver"
            android:exported="false" />

        <!-- Restores DND filter after silent-during-prayer window expires -->
        <receiver
            android:name=".prayer.silent.RestorePrayerSilentReceiver"
            android:exported="false" />

        <!-- Fires at end of the "Go to Mosque" window and flips DND on for the silent-during-prayer duration -->
        <receiver
            android:name=".prayer.silent.StartPrayerSilentReceiver"
            android:exported="false" />

        <!-- Prayer Boot Receiver for automatic rescheduling after device restart -->
        <receiver
            android:name=".prayer.receiver.PrayerBootReceiver"
            android:exported="true"
            android:enabled="true">
            <!-- Boot and own-package updates. MUST NOT contain a <data> element:
                 a filter with a data scheme only matches intents that carry a
                 data URI, and BOOT_COMPLETED has none — combining them silently
                 broke boot delivery entirely. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <!-- Other-package updates carry a package: data URI, so the data
                 scheme lives in its own filter. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
            <!-- Timezone and time changes (separate filter, no data scheme) -->
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Quran Playback Service for background audio -->
        <service
            android:name=".feature.quran.QuranPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Chapter Recitation Service (single-track): Fortress duas + Bukhari hadith,
             with a MediaStyle notification + lock-screen controls. -->
        <service
            android:name=".services.ChapterRecitationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Driving Audio Service for travel dua, hadith, and TTS with notification controls -->
        <service
            android:name=".services.DrivingAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <!-- Activity-Based Dua Service for sensor-based activity detection -->
        <service
            android:name=".service.ActivityBasedDuaService"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />
        
        <!-- Android Auto Car App Service -->
        <service
            android:name=".automotive.PrayerTimesCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Android Auto app metadata -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Disable Firebase analytics by default. This setting is overwritten for the `prod`
        flavor -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <!-- Disable collection of AD_ID for all build variants -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <!-- Firebase automatically adds the following property which we don'''t use so remove it -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            tools:node="remove" />

    </application>

</manifest>
