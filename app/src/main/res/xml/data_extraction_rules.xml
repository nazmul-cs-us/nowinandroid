<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+) cloud backup.
    Controls what data is backed up to Google's cloud backup service.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up shared preferences only (prayer settings, app preferences) -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow all data during device-to-device transfer -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
