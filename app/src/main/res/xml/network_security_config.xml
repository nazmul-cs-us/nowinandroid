<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration.
    Enforces HTTPS for all connections except debug builds.
-->
<network-security-config>
    <!-- Production: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext for CDN domain during debug builds only -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
