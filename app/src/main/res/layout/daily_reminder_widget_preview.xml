<?xml version="1.0" encoding="utf-8"?>
<!-- Current Daily Reminder hierarchy for Android 12+ widget pickers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_daily_reminder_flaticon"
            android:tint="@color/prayer_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Daily Reminder"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_refresh_icon"
            android:tint="@color/prayer_widget_muted" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/prayer_widget_chip_background"
        android:fontFamily="@font/ubuntu_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp"
        android:text="HADITH"
        android:textColor="@color/prayer_widget_on_card"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/ubuntu_sans"
        android:includeFontPadding="false"
        android:maxLines="4"
        android:text="The Prophet ﷺ taught us to bring mindfulness and kindness into our daily actions."
        android:textColor="@color/prayer_widget_on_background"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Bukhari"
            android:textColor="@color/prayer_widget_muted"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="#154 · Ablutions"
            android:textColor="@color/prayer_widget_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
