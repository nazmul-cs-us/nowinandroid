<?xml version="1.0" encoding="utf-8"?>
<!--
     Host-side carousel for footprints too short to stack all three cards. Each page is a
     bitmap of one card — hero, Today's Prayers, Dua & Hadith — rendered in the app's own
     process (see buildSectionFlipper) so the launcher just cycles three images. A short
     crossfade is right here: the pages are different content, so the overlap reads as a
     transition rather than a colour shift.
-->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateFirstView="false"
    android:autoStart="true"
    android:flipInterval="7000"
    android:inAnimation="@anim/widget_section_fade_in"
    android:measureAllChildren="true"
    android:outAnimation="@anim/widget_section_fade_out">

    <ImageView
        android:id="@+id/section_page_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/section_page_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/section_page_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</ViewFlipper>
