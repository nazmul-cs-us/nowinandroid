<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the 2x2 entry.

     Colours come from the prayer_widget_* tokens, which were sampled out of
     platform-samples' own preview assets so these entries sit in the picker with the
     same surface and text colours as the ported widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ASR"
        android:textColor="@color/prayer_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4:12"
        android:textColor="@color/prayer_widget_on_background"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="in 1h 20m"
        android:textColor="@color/prayer_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
