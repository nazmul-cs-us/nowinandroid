<?xml version="1.0" encoding="utf-8"?>
<!--
     4x2 picker entry: the illustrated hero, as the widget actually draws it.

     This used to be a generic card — a location row, a progress bar and a "next prayer"
     line — which shared nothing with the widget it was advertising. The preview now stands
     on the same artwork plate the hero uses, so what the picker shows is what gets placed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_flaticon_location_marker"
            android:tint="@color/prayer_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Dubai"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/prayer_widget_reference_hero_v4">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="Best Time to Pray Maghrib"
                android:textColor="#FFF4F1E6"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="46m since Maghrib"
                android:textColor="#FFF4F1E6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- A FrameLayout, not a Space: previewLayout has to inflate as RemoteViews,
                 and Space is not on the remotable whitelist — the launcher answers
                 "Couldn't add widget." -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="Isha"
                android:textColor="#FFF4F1E6"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="in 28m"
                android:textColor="#FFD8C9A8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
