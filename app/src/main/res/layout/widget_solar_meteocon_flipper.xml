<?xml version="1.0" encoding="utf-8"?>
<!--
     The Meteocons sunrise/sunset artwork rotates its eight symmetric rays once over
     six seconds. Twenty-four full-loop samples advance every 250ms, retaining the
     source duration; a short crossfade softens the remaining 15-degree steps.
-->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meteocon_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:animateFirstView="false"
    android:flipInterval="250"
    android:inAnimation="@anim/widget_meteocon_fade_in"
    android:measureAllChildren="true"
    android:outAnimation="@anim/widget_meteocon_fade_out">

    <ImageView
        android:id="@+id/meteocon_frame_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

