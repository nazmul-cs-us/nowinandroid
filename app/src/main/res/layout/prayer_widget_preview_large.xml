<?xml version="1.0" encoding="utf-8"?>
<!--
     4x3 picker entry: the sun-path card, which is the page this size leads with.
     Built on the same skyline artwork the widget draws, over the twilight palette.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="HardcodedText">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/prayer_widget_preview_sky">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="34dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/prayer_widget_skyline_v1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="9dp"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Today's Prayers"
            android:textColor="#FFF4F1E6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="bottom"
            android:background="#E6091A18"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Fajr\n4:48 AM"
                android:textColor="#FFB9C7C0"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Dhuhr\n12:16 PM"
                android:textColor="#FFB9C7C0"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Asr\n3:44 PM"
                android:textColor="#FFB9C7C0"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Maghrib\n6:24 PM"
                android:textColor="#FFB9C7C0"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Isha\n7:39 PM"
                android:textColor="#FFFFD86A"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
