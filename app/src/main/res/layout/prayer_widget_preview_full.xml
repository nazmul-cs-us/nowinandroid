<?xml version="1.0" encoding="utf-8"?>
<!-- Tall picker preview mirrors the live prayer hero, timeline and devotional reading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="4dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_flaticon_location_marker"
            android:tint="@color/prayer_widget_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Dhaka, Bangladesh"
                android:textColor="@color/prayer_widget_on_background"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Thursday, 19 Rabi I 1448 AH"
                android:textColor="@color/prayer_widget_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/flaticon_weather_partly_cloudy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="28 degrees"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_refresh_icon"
            android:tint="@color/prayer_widget_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/prayer_widget_hero_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="2h 9m since Dhuhr"
                android:textColor="@color/prayer_widget_on_hero"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="Maghrib"
                android:textColor="@color/prayer_widget_on_hero"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="in 2h 17m"
                android:textColor="@color/prayer_widget_on_hero"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="A moment to pause and turn to Allah."
                android:textColor="@color/prayer_widget_on_hero"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="94dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/prayer_insight_maghrib" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/prayer_widget_card_background"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="Today's Prayers"
                android:textColor="@color/prayer_widget_on_background"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="View schedule"
                android:textColor="@color/prayer_widget_accent"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include layout="@layout/prayer_widget_preview_timeline_fajr" />
            <include layout="@layout/prayer_widget_preview_timeline_dhuhr" />
            <include layout="@layout/prayer_widget_preview_timeline_asr" />
            <include layout="@layout/prayer_widget_preview_timeline_maghrib" />
            <include layout="@layout/prayer_widget_preview_timeline_isha" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/prayer_widget_accent" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/prayer_widget_muted" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/prayer_widget_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="78dp"
            android:layout_height="112dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/insight_quran" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="Dua &amp; Hadith"
                android:textColor="@color/prayer_widget_on_background"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="O Allah, You are Peace, and from You comes peace."
                android:textColor="@color/prayer_widget_on_background"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/ubuntu_sans"
                android:includeFontPadding="false"
                android:text="Sahih Muslim 591"
                android:textColor="@color/prayer_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
