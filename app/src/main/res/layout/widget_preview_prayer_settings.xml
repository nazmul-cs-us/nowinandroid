<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_home_icon"
            android:tint="@color/prayer_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Prayer Settings"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_power_settings_icon"
            android:tint="@color/prayer_widget_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/prayer_widget_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_adhan_icon"
            android:tint="@color/prayer_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Adhan notifications"
            android:textColor="@color/prayer_widget_on_card"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="ON"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_silent_icon"
            android:tint="@color/prayer_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Silent during prayer"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="ON"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/sample_mosque_icon"
            android:tint="@color/prayer_widget_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="Mosque reminder"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ubuntu_sans"
            android:includeFontPadding="false"
            android:text="OFF"
            android:textColor="@color/prayer_widget_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
