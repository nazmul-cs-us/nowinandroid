<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the 2x1 entry.

     Colours come from the prayer_widget_* tokens, which were sampled out of
     platform-samples' own preview assets so these entries sit in the picker with the
     same surface and text colours as the ported widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="4:12 PM"
            android:textColor="@color/prayer_widget_on_background"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
