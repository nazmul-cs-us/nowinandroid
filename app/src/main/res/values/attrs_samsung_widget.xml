<?xml version="1.0" encoding="utf-8"?>
<!--
     Samsung One UI Home reads these two attributes off an appwidget-provider by name and
     echoes them back to the widget as semWidgetStyle / semWidgetSize in its options bundle.
     Values and flag names match the declarations in Samsung's own widget apps (Now Brief).
     They do not make the launcher blur the wallpaper behind a third-party widget — Samsung's
     widgets draw that themselves from the wallpaper bitmap, which needs system privileges.
     Neither attribute is part of AOSP, so they have to be declared here for aapt.
-->
<resources>
    <attr name="widgetStyle" format="integer">
        <flag name="colorful" value="0x1" />
        <flag name="monotone" value="0x2" />
    </attr>

    <attr name="widgetSize" format="integer">
        <flag name="tiny" value="0x1" />
        <flag name="small" value="0x2" />
        <flag name="wideSmall" value="0x4" />
        <flag name="medium" value="0x8" />
        <flag name="large" value="0x10" />
        <flag name="extraLarge" value="0x20" />
    </attr>
</resources>
