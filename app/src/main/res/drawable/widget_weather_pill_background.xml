<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference header capsule: a cool blue-white wash rather than a flat grey fill.
  Two very low-alpha offset layers approximate the reference's diffuse lavender shadow;
  the foreground ends 2dp above the drawable bottom so the halo stays restrained.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0862708F" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A7B86A3" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="0dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#F5F6FB"
                android:endColor="#E9EBF6"
                android:startColor="#E3EBFA" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
