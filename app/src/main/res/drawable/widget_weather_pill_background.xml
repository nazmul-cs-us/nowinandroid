<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference header capsule, sampled from the supplied design: a flat lavender-grey with only
  a hint of top light. A radius beyond half the chip height renders as a true capsule.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E9EAF1"
        android:endColor="#E1E3EB" />
    <corners android:radius="100dp" />
</shape>
