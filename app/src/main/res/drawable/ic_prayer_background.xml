    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.15"
        android:pathData="M0,0L4,0L4,4L0,4Z" />
    
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.15"
        android:pathData="M20,0L24,0L24,4L20,4Z" />
    
    <path
