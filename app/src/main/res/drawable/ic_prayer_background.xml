        android:fillAlpha="0.15"
        android:pathData="M0,20L4,20L4,24L0,24Z" />
    
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.15"
        android:pathData="M20,20L24,20L24,24L20,24Z" />
    
