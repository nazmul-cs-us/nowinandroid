<?xml version="1.0" encoding="utf-8"?><!--
  Three stops approximate a soft frosted edge in RemoteViews, where RenderEffect blur is
  unavailable. Opaque at the header, gently translucent through the middle, then clear.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#73ECF0FF"
        android:endColor="#F2ECF0FF"
        android:startColor="#00ECF0FF"
        android:type="linear" />
</shape>
