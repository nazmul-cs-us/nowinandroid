<?xml version="1.0" encoding="utf-8"?><!--
  The footer fade turned over: opaque at the card's top edge, clear where the text
  resumes, so a line scrolling up dissolves into the header instead of being sliced by it.
  Angle 90 rather than the footer's 270 is the whole difference.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#E6ECF0FF"
        android:startColor="#00ECF0FF"
        android:type="linear" />
</shape>
