<?xml version="1.0" encoding="utf-8"?>
<!--
  Ubuntu Sans as bundled TTFs, for the home-screen widget.

  The app's own @font/ubuntu_sans is a *downloadable* family served by Play Services. That
  cannot be used in a widget: RemoteViews is inflated in the launcher's process, where a
  downloadable font resolves asynchronously through the provider and the launcher will have
  drawn long before it arrives — so it silently renders in the fallback face.

  These are the same four weights the app theme loads (see designsystem Type.kt), declared
  as static assets so inflation resolves them immediately from the merged resource table.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/ubuntu_sans_light"
        android:fontStyle="normal"
        android:fontWeight="300" />
    <font
        android:font="@font/ubuntu_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/ubuntu_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/ubuntu_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
