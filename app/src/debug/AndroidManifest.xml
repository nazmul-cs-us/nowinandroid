<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Renders a chosen size bucket in an already-placed widget by rewriting its
             size options. Glance picks its layout from the size the host reports, and
             there is no adb command to place or resize a widget, so without this a 2x1
             layout can only be seen by dragging a 2x1 out of the picker by hand. -->
        <receiver
            android:name="com.starception.submission.widget.DebugResizeWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.starception.submission.DEBUG_RESIZE_WIDGET" />
            </intent-filter>
        </receiver>

        <!-- Renders the widget at each picker size to a PNG, so the previews can be the
             widget itself rather than a hand-built likeness of it. -->
        <receiver
            android:name="com.starception.submission.widget.DebugWidgetPreviewReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.starception.submission.DEBUG_RENDER_PREVIEWS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
