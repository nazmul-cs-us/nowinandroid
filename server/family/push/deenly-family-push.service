[Unit]
Description=Deenly Family call push delivery
After=network-online.target
Wants=network-online.target

[Service]
User=mongooseim
Group=mongooseim
EnvironmentFile=/etc/mongooseim/family-push.env
ExecStart=/opt/deenly-family-push/venv/bin/python /opt/deenly-family-push/bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/var/lib/deenly-family-web
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
